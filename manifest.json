{
    "manifest_version": 3,
    "name": "学习通复制粘贴助手",
    "short_name": "学习通粘贴助手",
    "version": "1.1.0",
    "description": "解除学习通页面的复制、剪切、粘贴、右键和文本选择限制，支持 MAIN 环境与嵌套 iframe。",
    "minimum_chrome_version": "111",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://*.chaoxing.com/*"
    ],
    "background": {
        "service_worker": "src/background.js"
    },
    "action": {
        "default_title": "学习通粘贴助手",
        "default_popup": "src/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.chaoxing.com/*"
            ],
            "js": [
                "src/defaults.js",
                "src/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true,
            "world": "ISOLATED"
        },
        {
            "matches": [
                "https://*.chaoxing.com/*"
            ],
            "js": [
                "src/page-runtime.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true,
            "world": "MAIN"
        }
    ]
}